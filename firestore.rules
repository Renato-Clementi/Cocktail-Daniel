rules_version = '2';

// ==================================================
// COCKTAIL DANIEL SRL — Regole di sicurezza Firestore
// ==================================================
// Questo file esiste perché le regole che governano l'accesso ai dati
// vivevano SOLO nella console Firebase: non si potevano rivedere,
// confrontare o ripristinare, e nessuno poteva accorgersi se cambiavano.
// Il README ne citava una versione (firestore_rules_v10.txt) che non era
// mai stata messa nel repository.
//
// ⚠️ QUESTE REGOLE SONO DELIBERATAMENTE PERMISSIVE, e rispecchiano quelle
// attualmente pubblicate. Vanno bene per un'app familiare a fiducia
// reciproca; NON vanno bene per un'app raggiungibile da chiunque, come
// questa è, essendo pubblicata su GitHub Pages da un repository pubblico.
//
// Con "allow read, write: if true" chiunque trovi l'URL può leggere,
// modificare e cancellare qualunque documento chiamando l'API REST
// direttamente, senza nemmeno aprire l'app: saldi delle carte, ordini,
// nomi e storico acquisti di tutti. Nessuna delle protezioni scritte in
// JavaScript dentro index.html è nel percorso: il browser è dell'utente,
// e il codice che gira lì si può cambiare.
//
// Il rimedio è attivare Firebase Authentication (basta quella anonima,
// invisibile all'utente: nessun login da fare) e legare ogni documento al
// suo proprietario. In fondo al file c'è una bozza pronta, commentata.
// Serve accesso alla console Firebase per attivare l'autenticazione e
// pubblicare le regole nuove.
//
// Per pubblicare: Firebase Console → Firestore Database → Regole,
// oppure `firebase deploy --only firestore:rules` con la CLI.
// ==================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /orders/{document=**}            { allow read, write: if true; }
    match /payments/{document=**}          { allow read, write: if true; }
    match /settings/{document=**}          { allow read, write: if true; }
    match /reviews/{document=**}           { allow read, write: if true; }
    match /chores/{document=**}            { allow read, write: if true; }
    match /wallets/{document=**}           { allow read, write: if true; }
    match /topupRequests/{document=**}     { allow read, write: if true; }
    match /partyBookings/{document=**}     { allow read, write: if true; }
    match /digitalPurchases/{document=**}  { allow read, write: if true; }
    match /donations/{document=**}         { allow read, write: if true; }
    match /checklistPhotos/{document=**}   { allow read, write: if true; }
  }
}

// ==================================================
// BOZZA per quando ci sarà l'autenticazione
// ==================================================
// Non è ancora attiva: serve prima abilitare Firebase Authentication
// (Accesso anonimo) dalla console, e far chiamare all'app
// firebase.auth().signInAnonymously() all'avvio. Il ruolo di admin va su
// un custom claim del token, non sul nome digitato alla registrazione.
